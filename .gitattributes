# The catalogue is consumed from a fresh public checkout, and several artifacts are byte contracts.
# Pin the line endings that matter rather than letting core.autocrlf materialize them differently
# per host.

# Executable/scripts and tooling.
*.sh text eol=lf
*.py text eol=lf

# Manifests and metadata are inspected by Engine and validated by tools whose output must be
# deterministic; a CRLF-materialized Manifest would change the bytes Engine reads and the
# materializer writes.
*.json text eol=lf

# Documentation read by humans and CI.
*.md text eol=lf
CHANGELOG.md text eol=lf
